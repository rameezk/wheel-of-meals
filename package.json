{
  "name": "wheel-of-meals",
  "version": "0.0.0",
  "description": "Randomise your meals for the week.",
  "scripts": {
    "dev": "vite",
    "dev:worker": "npm run db:migrate:local && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply wheel-of-meals --local",
    "build": "vite build",
    "preview": "npm run build && npm run db:migrate:local && wrangler dev",
    "deploy": "npm run build && wrangler d1 migrations apply wheel-of-meals --remote && wrangler deploy",
    "preview:migrate": "wrangler d1 migrations apply wheel-of-meals-preview --remote --env preview",
    "preview:seed": "wrangler d1 execute wheel-of-meals-preview --remote --env preview --yes --file scripts/preview-seed.sql",
    "typecheck": "wrangler types && tsc --build --force",
    "lint": "eslint . && prettier --check . && shellcheck scripts/*.sh",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cf-typegen": "wrangler types"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rameezk/wheel-of-meals.git"
  },
  "license": "MIT",
  "type": "module",
  "private": true,
  "dependencies": {
    "hono": "^4.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^30.0.1",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260730.1": true
  }
}
